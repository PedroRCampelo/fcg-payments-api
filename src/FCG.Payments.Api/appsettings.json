{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "fcg-payments-api"
    }
  },
  "Jwt": {
    "Issuer": "fcg-users-api",
    "Audience": "fcg"
  },
  "Payments": {
    "LimiteDeAprovacao": 200
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Queues": {
      "PaymentsOrderPlaced": "payments.order-placed",
      "CatalogPaymentProcessed": "catalog.payment-processed",
      "NotificationsPaymentProcessed": "notifications.payment-processed"
    }
  },
  "AllowedHosts": "*"
}
